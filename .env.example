# =============================================================
# Temperature 平台统一配置（Docker Compose 与后端服务共用）
#
# 使用方式：
#   cp .env.example .env      # 复制模板并按实际情况修改
#   docker compose up -d      # Compose 自动读取同目录下的 .env
#
# 提示：.env 不要提交到版本库（已被 .gitignore 忽略）。
# =============================================================

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=temperature
MYSQL_PASSWORD=temperature123
MYSQL_DATABASE=temperature
MYSQL_ROOT_PASSWORD=root

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=temperature123

# ---- 雪花 ID ----
# 多实例部署时每台机器取不同值
SNOWFLAKE_WORKER_ID=1

# ---- 鉴权（生产环境用 openssl rand -hex 32 生成）----
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 邮箱验证码 ----
EMAIL_CODE_EXPIRE_SECONDS=300
EMAIL_CODE_MAX_ATTEMPTS=5

# ---- 登录失败锁定 ----
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# ---- 邮件 ----
# console：验证码只打印到服务输出（本地开发，不需要任何邮件容器）
# smtp：经真实 SMTP 服务器发送（生产环境必须用这个）
EMAIL_BACKEND=console

# ---- SMTP（EMAIL_BACKEND=smtp 时生效）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM_EMAIL=

# ---- 服务 ----
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
