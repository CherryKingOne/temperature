# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=temperature
MYSQL_PASSWORD=temperature123
MYSQL_DATABASE=temperature

# ---- 缓存 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=temperature123

# ---- 鉴权（生产环境用 openssl rand -hex 32 生成）----
JWT_SECRET_KEY=please-change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 邮箱验证码 ----
EMAIL_CODE_EXPIRE_SECONDS=300
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# ---- 登录失败锁定 ----
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# ---- SMTP（本地开发用 Mailpit: docker compose up -d mailpit）----
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@temperature.local

# ---- 服务 ----
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
